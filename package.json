{
  "name": "daxxer",
  "version": "1.0.0",
  "description": "Daxxer — a block-based workspace desktop app. Pages, a block editor, and typed databases.",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "serve": "node server.js",
    "dev": "node --watch server.js",
    "seed": "node lib/reset.js",
    "icon": "node electron/make-icon.cjs",
    "package": "electron-packager . Daxxer --platform=win32 --arch=x64 --out=dist --overwrite --no-asar --icon=electron/icon.ico --ignore=\"^/DaxxerOS_Local\" --ignore=\"^/dist\" --ignore=\"^/data\""
  },
  "engines": { "node": ">=18" },
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.2.1",
    "@electron/packager": "^18.3.6"
  }
}
